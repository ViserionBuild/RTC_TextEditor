{
  "name": "collabpad",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "WEB_DIST=${WEB_DIST:-../frontend/dist} pnpm --filter @collabpad/backend start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fuzz": "FUZZ_RUNS=10000 vitest run shared/sim/test/fuzz.test.ts",
    "demo:3clients": "pnpm --filter @collabpad/backend demo",
    "backend": "pnpm --filter @collabpad/backend dev",
    "frontend": "pnpm --filter @collabpad/frontend dev",
    "dev": "pnpm --parallel --filter @collabpad/backend --filter @collabpad/frontend dev",
    "e2e": "playwright test",
    "bench": "pnpm --filter @collabpad/bench bench",
    "bench:fetch": "pnpm --filter @collabpad/bench bench:fetch",
    "bench:charts": "pnpm --filter @collabpad/bench bench:charts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
